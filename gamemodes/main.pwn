					SendClientMessage(playerid, COLOR_WHITE, gString);

					DestroyDynamic3DTextLabel(JobInfo[job][jLabel]);
					DestroyDynamicPickup(JobInfo[job][jPickup]);

					format(gString, 128, "{ffffff}ID: {FF0000}%d\n{ffffff}Job: {FF0000}%s{FFFFFF}\nPress {FF0000}Y{FFFFFF} to get the job\nPress {FF0000}N{FFFFFF} to quit job", job, JobInfo[job][jName]);
