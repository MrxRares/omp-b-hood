	ChangeVehicleColorEx(vehicleid, VehicleStats[vehicleid][vColorOne], VehicleStats[vehicleid][vColorTwo]);
	return true;
}
stock SetVehiclePosEx(vehicleid, Float:x, Float:y, Float:z) {
