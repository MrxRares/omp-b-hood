					if(!PlayerToPoint(50, playerid,BizzInfo[biz][bExitX],BizzInfo[biz][bExitY],BizzInfo[biz][bExitZ]) && BizzInfo[biz][bStatic] == 0) return SendClientMessage(playerid, COLOR_GREY, "Nu esti langa afacerea ta!");
