redist::FixHour(hour) {
	hour = timeshift+hour;
	if(hour < 0) hour = hour+24;
	else if(hour > 23) hour = hour-24;
	shifthour = hour;
	return true;
}
	
redist::UnFreezeStation(playerid) {
	TogglePlayerControllable(playerid, 1);
	UnFreezeTimer[playerid] = -1;
	return true;
}
