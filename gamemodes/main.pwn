    CreateDynamic3DTextLabel("Rent Car\n\n{FFFFFF}Use [{2B6CB2}/rentcar{FFFFFF}] to rent a car", 0x2B6CB2FF, -1985.1903,265.0845,35.1794, 10.0);
	CreateDynamicPickup(1096, 23, -1985.1903,265.0845,35.1794);
