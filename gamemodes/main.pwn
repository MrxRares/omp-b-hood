			    case 2: ShowPlayerDialog(playerid, DIALOG_CLAN_RANK, DIALOG_STYLE_INPUT, "{F4AD42}Clan {FFFFFF}Settings", "Introdu numele pe care vrei sa-l pui la rankuri.", "Select", "Back");
				case 3: {
