					mysql_tquery(SQL, gQuery);
					SendClientMessage(playerid, COLOR_YELLOW, "Congratulations! You reset the vehicle days!");
				}
			}

			PlayerInfo[playerid][pTickete][listitemm[playerid]] --;	
			save_tickete(playerid);	
