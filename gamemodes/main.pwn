stock randomString(const max, empty=5, const empty_char = ' ', i=0, const chars[] = {"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"}) {
    new _ret[64]; ++empty;
    while(++i<=max) _ret[i-1]=i%empty?chars[random(36)]:empty_char;
    return _ret;
}

