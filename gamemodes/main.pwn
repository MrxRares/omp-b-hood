					mysql_format(SQL, gQuery, 128, "UPDATE `cars` SET `KM` = '0.0' WHERE `ID` = '%i'", CarInfo[idd][cID]);
					mysql_tquery(SQL, gQuery);
					SendClientMessage(playerid, COLOR_YELLOW, "Congratulations! You reset the vehicle KM!");
				}
				case 6: {				
