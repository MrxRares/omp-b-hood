	new x=0;
	foreach(new i : Staff<HELPER>) if(AFKSeconds[i]>=10) x++;
	return x;
}
redist::CheckLeaders(caz) {
	new x=0;
	foreach(new i : faction_leaders) if(AFKSeconds[i]>=10) x++;
	return x;
}
