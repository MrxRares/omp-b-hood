			_query("UPDATE `clanvehicle` SET `RainBow`='%d' WHERE `ID`='%d'", CarInfo[idd][cRainBow], CarInfo[idd][cID]);
		}
		case DIALOG_CLANVRANK: {
			if(!response)
				return true;

			new rank = strval(inputtext),idd=PlayerInfo[playerid][pCarKey][listitemm[playerid]],clanid=PlayerInfo[playerid][pClan];
			if(rank <= 0 || rank >= 7)
				return SendClientMessage(playerid, -1, "Rank invalid (1 - 6)");

			CarInfo[idd][cRank] = rank;
			format(gString, 128, "{%s}[CLAN] %s a setat rank %d pentru vehiculul %s.", ClanInfo[clanid][clColor], GetName(playerid), rank, GetVehicleName(CarInfo[idd][cModel]));
			SendClanMessage(PlayerInfo[playerid][pClan], gString);
			mysql_format(SQL, gQuery, 128, "UPDATE `clanvehicle` SET `Rank` = '%i' WHERE `ID` = '%i'", rank, CarInfo[idd][cID]);
			mysql_tquery(SQL, gQuery);
		}
		case DIALOG_SELLCLANV: {
