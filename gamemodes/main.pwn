					ShowPlayerDialog(playerid, DIALOG_CLANNAME, DIALOG_STYLE_INPUT, "{F4AD42}Clan {FFFFFF}Change name", "Introdu mai jos numele pe care doresti sa-l aiba clanul.\nAceasta schimbare costa 200 Premium Points, gandeste-te bine la alegere!", "Select", "Back");
