		case DIALOG_UPSTAGE: {
			if(!response) return true;
			new idd = FindSpawnID(GetPlayerVehicleID(playerid));
			if(idd == -1) return true;
			if(CarInfo[idd][cStage] >= (!CarInfo[idd][cClan]?4:3)) return SendClientMessage(playerid, -1, "Acest vehicul este upgradat la stage maximum!");
			if(IsABike(CarInfo[idd][cModel])) return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Nu poti upgrada acest vehicul!");
			if(!CarInfo[idd][cClan]) {
				if(PlayerInfo[playerid][pPremiumPoints] < StagePrice[CarInfo[idd][cStage]+1]) return SendClientMessage(playerid, -1, "Nu ai destule Premium Points.");
				PlayerInfo[playerid][pPremiumPoints] -= StagePrice[CarInfo[idd][cStage]+1];
				Iter_Add(IsSpeed, playerid);
				UpdateVar(playerid, "GoldPoints", PlayerInfo[playerid][pPremiumPoints]);
				mysql_format(SQL, gQuery, 128, "UPDATE `cars` SET `Stage`='%d' WHERE `ID`='%d'", CarInfo[idd][cStage]+1, CarInfo[idd][cID]);
				mysql_tquery(SQL, gQuery);
			} else {
				new clanid = CarInfo[idd][cClan];
				if(ClanInfo[clanid][clPremiumPoints] < StagePrice[CarInfo[idd][cStage]+1]) return SendClientMessage(playerid, -1, "Nu sunt destule premium points in clan.");
				ClanInfo[clanid][clPremiumPoints] -= StagePrice[CarInfo[idd][cStage]+1];
				mysql_format(SQL, gQuery, 127, "UPDATE `clans` SET `PremiumPoints` = '%i' WHERE `ID` = '%i'", ClanInfo[clanid][clPremiumPoints], ClanInfo[clanid][cID]);
				mysql_tquery(SQL, gQuery);
				mysql_format(SQL, gQuery, 128, "UPDATE `clanvehicle` SET `Stage`='%d' WHERE `ID`='%d'", CarInfo[idd][cStage]+1, CarInfo[idd][cID]);
				mysql_tquery(SQL, gQuery);				
			}
			SCMf(playerid, COLOR_WHITE, "{227FC3}Tunning System: {FFFFFF}You upgrade your vehicle successfully to stage %d for %d premium points.", CarInfo[idd][cStage]+1, StagePrice[CarInfo[idd][cStage]+1]);
			CarInfo[idd][cStage] ++;
   			if(CarInfo[idd][cStage] <= 3) format(string, sizeof(string), "Your vehicle is~y~ %s~n~~w~~h~Max. speed:~y~ %d km/h~n~~w~~h~Current stage:~y~ %d/%d~w~~h~~n~boost: ~y~+%d km/h~w~~h~ / ~b~ %d km/h"
		    ,aVehicleNames[GetVehicleModel(GetPlayerVehicleID(playerid))-400], GetVehicleMaxSpeed(CarInfo[idd][cModel]), CarInfo[idd][cStage], !CarInfo[idd][cClan] ? 4 : 3, StageSpeed[CarInfo[idd][cStage]], (GetVehicleMaxSpeed(CarInfo[idd][cModel]) + StageSpeed[CarInfo[idd][cStage]]));
		    else format(string, sizeof(string), "Your vehicle is~y~ %s~n~~w~~h~Max. speed:~y~ %d km/h~n~~w~~h~Current stage:~y~ %d/4~w~~h~~n~boost: launch control"
		    ,aVehicleNames[GetVehicleModel(GetPlayerVehicleID(playerid))-400], ((StageSpeed[CarInfo[idd][cStage]]) + (GetVehicleMaxSpeed(CarInfo[idd][cModel]))), CarInfo[idd][cStage]);
		    PlayerTextDrawSetString(playerid, StagePTD, string);

