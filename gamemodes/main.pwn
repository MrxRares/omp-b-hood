cmd:shop(playerid, params[]) return ShowPlayerDialog(playerid, DIALOG_SHOPMENU, DIALOG_STYLE_TABLIST_HEADERS, "Shop Menu", "Shop Type\tItem\n{FFEA3B}[+] Shop Info{FFFFFF}\nNormal Shop\t18 items\nVip Cars\t11 items\nExtra Packs\t3 items\nCustom House\t{CA7673}2000 premium points\nAccount upgrade\t5 item", "Select", "Cancel");

redist::ShowShop(playerid) {
	new gold = PlayerInfo[playerid][pPremiumPoints], szDialog[2000]; gString[0] = (EOS);
