	    case DIALOG_CHECKPOINT: {
	        if(!response) return true;
			if(InExamen[playerid]) 
				FailExamen(playerid);

			if p_rob[playerid][r_coPlayer]!=-1 *then return stop_rob(playerid, 4);
			DisablePlayerRaceCheckpointEx(playerid);
