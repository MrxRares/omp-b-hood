		    if(ServerStock[2]) format(stocks, 25, "%d stock", ServerStock[2]);
			format(gString, 128, "{FFFFFF}10.\tNRG Premium (%s)\t{%s}1500 premium points\n", ServerStock[2]?stocks:("{CA7673}out of stock{FFFFFF}"), gold >= 1500?("B6F2B5"):("CA7673"));
			strcat(szDialog, gString);
		    if(ServerStock[3]) format(stocks, 25, "%d stock", ServerStock[3]);
			format(gString, 128, "{FFFFFF}11.\tBullet Premium (%s)\t{%s}2000 premium points\n", ServerStock[3]?stocks:("{CA7673}out of stock{FFFFFF}"), gold >= 2000?("B6F2B5"):("CA7673"));
			strcat(szDialog, gString);
		    if(ServerStock[4]) format(stocks, 25, "%d stock", ServerStock[4]);
			format(gString, 128, "{FFFFFF}12.\tSultan Premium (%s)\t{%s}1000 premium points\n", ServerStock[4]?stocks:("{CA7673}out of stock{FFFFFF}"), gold >= 1000?("B6F2B5"):("CA7673"));
			strcat(szDialog, gString);
		    if(ServerStock[5]) format(stocks, 25, "%d stock", ServerStock[5]);
			format(gString, 128, "{FFFFFF}13.\tTurismo Premium (%s)\t{%s}869 premium points\n", ServerStock[5]?stocks:("{CA7673}out of stock{FFFFFF}"), gold >= 869?("B6F2B5"):("CA7673"));
			strcat(szDialog, gString);
		    ShowPlayerDialog(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Shop: VIP Cars", szDialog, "Select", "Close");
		}
		case 3: {
			SCMf(playerid, COLOR_LGREEN, "SHOP: You selected the 'Extra Packs' category and you have %d premium points.", PlayerInfo[playerid][pPremiumPoints]);
			strcat(szDialog, "#\tType\tPrice\n");
			strcat(szDialog, gold >= 1000?"{FFFFFF}1.\tStarter Pack\t{B6F2B5}1000 premium points\n":"{FFFFFF}1.\tStarter Pack\t{CA7673}1000 premium points\n");
			strcat(szDialog, gold >= 850?"{FFFFFF}2.\tVoucher Pack\t{B6F2B5}850 premium points\n":"{FFFFFF}2.\tVoucher Pack\t{CA7673}850 premium points\n");
			strcat(szDialog, gold >= 500?"{FFFFFF}3.\tVehicle Pack\t{B6F2B5}500 premium points\n":"{FFFFFF}3.\tVehicle Pack\t{CA7673}500 premium points\n");	
		    ShowPlayerDialog(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Shop: Extra Packs", szDialog, "Select", "Close");
		}
		case 4: {
			if(PlayerInfo[playerid][pPremiumPoints] < 2000) return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "Not enough points", "You don't have premium points to do this.", "Close", "");
	        PlayerInfo[playerid][pPremiumPoints] -= 2000;
		   	PlayerInfo[playerid][pTickete][3] ++;
	        SendClientMessage(playerid, COLOR_GREEN, "(SHOP INFO){D7FFB3} Felicitari! ti-ai cumparat un Custom House Ticket. (-2000 premium points)");
	       	format(gString, sizeof(gString), "%s si-a achizitionat un Custom House Ticket pentru 2000 Premium Points.", GetName(playerid));
			InsertLog(playerid, gString, LOG_SHOP);
			save_tickete(playerid);
			}

		case 5: {
			SCMf(playerid, COLOR_LGREEN, "SHOP: You selected the 'Account Upgrade' category and %d premium points.", PlayerInfo[playerid][pPremiumPoints]);
			strcat(szDialog, "#\tType\tPrice\n");
			strcat(szDialog, gold >= 500 && PlayerInfo[playerid][pExp] >= 500 && PlayerInfo[playerid][pLevel] >= 100 ?"{FFFFFF}1.\tReborn\t{B6F2B5}500 premium points and 500 RP\n":"{FFFFFF}1.\tReborn\t{CA7673}500 premium points and 500 RP\n");
			strcat(szDialog, gold >= 150?"{FFFFFF}2.\tPremium Account\t{B6F2B5}150 premium points\n":"{FFFFFF}2.\tPremium Account\t{CA7673}150 premium points\n");	
			strcat(szDialog, "{FFFFFF}3.\tPremium Account Plus\t{98FF5C}2 miliards {FFFFFF}& {D373FF}5000 b-points\n");
			strcat(szDialog, gold >= 800?"{FFFFFF}4.\tVIP Account\t{B6F2B5}800 premium points\n":"{FFFFFF}4.\tVIP Account\t{CA7673}800 premium points\n");
			strcat(szDialog, gold >= 500?"{FFFFFF}5.\tVIP Account Plus\t{B6F2B5}500 premium points\n":"{FFFFFF}5.\tVIP Account Plus\t{CA7673}500 premium points\n");
			strcat(szDialog, gold >= 1337?"{FFFFFF}6.\tLegend\t{B6F2B5}1337 premium points\n":"{FFFFFF}6.\tLegend\t{CA7673}1337 premium points\n");
			ShowPlayerDialog(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Shop: Account Upgrade", szDialog, "Select", "Close");
		}
	}
	return true;
}
