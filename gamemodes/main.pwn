				case 5: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
					if(ClanInfo[clanid][clPremiumPoints] < 50) return SendClientMessage(playerid, COLOR_GREY, "Ai nevoie de 50 premium points in clan pentru aceasta optiune.");
					new mslot=60;
					if(ClanInfo[clanid][clPremium]) mslot += 30;
					if(ClanInfo[clanid][clVIP]) mslot += 30;

					if(ClanInfo[clanid][clSlots] >= mslot) return SCMf(playerid, COLOR_GREY, "Nu poti cumpara mai mult de %d sloturi!", mslot);
					ClanInfo[clanid][clPremiumPoints] -= 50;
					ClanInfo[clanid][clSlots] += 30;
					mysql_format(SQL, gQuery, 128, "UPDATE `clans` SET `Slots`='%i', `PremiumPoints` = '%i' WHERE `ID`='%i'", ClanInfo[clanid][clDays], ClanInfo[clanid][clPremiumPoints], clanid);
					mysql_tquery(SQL, gQuery, "", "");
					SCMf(playerid, COLOR_MONEY, "Ai marit sloturile clanului cu 30 mai multe in total %d!", ClanInfo[clanid][clSlots]);
				}
				case 6: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
					if(GetPlayerBank(playerid) < 5000000) return SendClientMessage(playerid, COLOR_GREY, "Ai nevoie de $5.000.000 in bank pentru aceasta optiune.");
					GivePlayerBank(playerid, -5000000);
					ClanInfo[clanid][clDays] ++;
					SavePlayerBank(playerid);
					SCMf(playerid, COLOR_MONEY, "Ai marit zilele clanului cu o zi pentru $5.000.000. Clanul tau va expira peste %d zile.", ClanInfo[clanid][clDays]);
				}
				case 7: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
					if(ClanInfo[clanid][clBonus]>=(!ClanInfo[clanid][clVIP]?5:10))
						return SendClientMessage(playerid, COLOR_GREY, "Aceasta optiune este upgradata la maxim.");

					if(ClanInfo[clanid][clPremiumPoints] < 1000)
						return SendClientMessage(playerid, COLOR_GREY, "Ai nevoie de 1000 premium points in clan pentru aceasta optiune.");

					ClanInfo[clanid][clPremiumPoints] -= 1000;
					++ClanInfo[clanid][clBonus];
					mysql_format(SQL, gQuery, sizeof gQuery, "UPDATE `clans` SET `Bonus`='%i', `PremiumPoints` = '%i' WHERE `ID`='%i'", ClanInfo[clanid][clBonus], ClanInfo[clanid][clPremiumPoints], clanid);
					mysql_tquery(SQL, gQuery, "", "");					
					SCMf(playerid, COLOR_MONEY, "Ai marit procentul de bonus la job cu %d%s.", ClanInfo[clanid][clBonus] * 10, "%%");
				}
				case 8: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
					if(ClanInfo[clanid][clPremium])
						return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Acest clan este deja upgradat la PREMIUM!");

					if(ClanInfo[clanid][clPremiumPoints] < 1000)
						return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Nu ai suficiente premium points in clan!");

					ClanInfo[clanid][clPremiumPoints] -= 1000;
					ClanInfo[clanid][clPremium] = true;

					_query("UPDATE `clans` SET `Premium` = '1', `PremiumPoints` = '%i' WHERE `ID` = '%i'", ClanInfo[clanid][clPremiumPoints], clanid);
					SendClientMessage(playerid, COLOR_MONEY, "Ai upgradat clanul la unul de tip PREMIUM");
				}
				case 9: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
					if(!ClanInfo[clanid][clPremium])
						return SendClientMessage(playerid, COLOR_LGREEN, "Ai nevoie de clan PREMIUM!");

					if(ClanInfo[clanid][clVIP])
						return SendClientMessage(playerid, COLOR_LGREEN, "Ai deja clan VIP!");

					if(ClanInfo[clanid][clPremiumPoints] < 2000)
						return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Nu ai suficiente premium points in clan!");

					ClanInfo[clanid][clPremiumPoints] -= 2000;
					ClanInfo[clanid][clVIP] =  true;

					_query("UPDATE `clans` SET `VIP` = '1', `PremiumPoints` = '%i' WHERE `ID` = '%i'", ClanInfo[clanid][clPremiumPoints], clanid);
					SendClientMessage(playerid, COLOR_MONEY, "Ai upgradat clanul la unul de tip VIP");
				}
			}
		}
