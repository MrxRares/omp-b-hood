					ShowPlayerDialog(playerid, DIALOG_CHANGETAG, DIALOG_STYLE_INPUT, "{F4AD42}Clan {FFFFFF}Change Tag", "Introdu mai jos numele pe care doresti sa-l aiba tagul clanului.\nAceasta schimbare costa 50 Premium Points, gandeste-te bine la alegere!", "Select", "Back");
				}
				case 4: {
					if(PlayerInfo[playerid][pClanRank] < 7) return true;
