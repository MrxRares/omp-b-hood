				format(gString, 128, "Numele ales de tine este: %s.\nCel de-al doilea pas, este de a alege tagul clanului.\nTagul clanului trebuie sa contina intre 3 si 9 caractere.", ClanInfo[PlayerInfo[playerid][pClan]][clName]);
