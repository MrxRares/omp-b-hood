redist::GetBizzID() {
	for(new i = 1; i < sizeof(BizzInfo); i++) {
		if(strcmp(BizzInfo[i][bOwner], "The State", true) == 0 && BizzInfo[i][bOwned] == 1) return i;
	}
	return false;
