					strmid(CarInfo[idd][cText], PlayerInfo[playerid][pUsername], 0, MAX_PLAYER_NAME);
					mysql_format(SQL, gQuery, 128, "UPDATE `cars` SET `Text` = '%s' WHERE `ID` = '%i'", CarInfo[idd][cText], CarInfo[idd][cID]);
					mysql_tquery(SQL, gQuery);

