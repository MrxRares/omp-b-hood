			format(gString, 128, "%s has joined the paintball arena.", GetName(playerid));
			SendPaintMessage(listitem+1, COLOR_LIGHTGOLD, gString);
			ResetPlayerWeapons(playerid);
			PaintSpawn(playerid);
			lastKill[playerid] =  0;
			BizzInfo[BizzTypeID[14][0]][bBalance] += 10000;
			GivePlayerCash(playerid, -10000);
			if(PlayersOnPaint(listitem) == 2) {	
				PaintTime[listitem] = -1;
				PaintText[listitem] = 30;
				PaintVote[listitem] = 1;	
			}
