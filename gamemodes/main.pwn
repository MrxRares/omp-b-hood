				return ShowPlayerDialog(playerid, DIALOG_REGISTER2,DIALOG_STYLE_INPUT,"SERVER: Age","Set your age here:","Select","Cancel");
			
			PlayerInfo[playerid][pAge] = strval(inputtext);
