      		ShowPlayerDialog(playerid, DIALOG_CLAN_MANAGE2, DIALOG_STYLE_LIST, "{F4AD42}Clan {FFFFFF}Settings", "Uninvite\nGive rank\nClan warn\nUn Clan warn", "Ok" ,"Back");
		}
