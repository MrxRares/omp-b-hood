				case 4: SelectedHud[playerid] = 1, ShowPlayerDialog(playerid, DIALOG_HUDSELECT,DIALOG_STYLE_LIST,"{F4AD42}HUD {FFFFFF}Menu:",szDialog,"Select","Cancel"); 			
